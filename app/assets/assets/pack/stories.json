     },
     "characters": [
      "hero"
     ],
     "outfit": "home",
     "location": "hallway_closed"
    },
    {
     "id": "s9",
     "order": 6,
     "text": {
      "ru": "Вытираю рот полотенцем."
     },
     "audio": {
      "ru": "story_media/f5e9644e76ca7dcf6029da2efdc83f06cbb1c9e3714f61e6df3232a35fe04f62.mp3"

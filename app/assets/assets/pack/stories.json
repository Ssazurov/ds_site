     },
     "characters": [
      "hero"
     ],
     "outfit": "home",
     "location": "hallway_closed"
    },
    {
     "id": "s6",
     "order": 3,
     "text": {
      "ru": "Намазываю пасту на щётку."
     },
     "audio": {
      "ru": "story_media/c4406f322a16e012fb51475b7727acec3d3a1a9b5ad34b7a59a6b03452104293.mp3"
     },
     "image_by_hero": {
      "girl": "story_media/ab025ac076f4dc5ed705643b438733813e0de7c87bbc478fcbec8e2e5b359d6e.webp"
     },
     "characters": [
      "hero"
     ],
     "outfit": "home",
     "location": "hallway_closed"
    },
    {
     "id": "s7",
     "order": 4,
     "text": {
      "ru": "Чищу щёткой с пастой зубы."
     },
     "audio": {
      "ru": "story_media/68141de2f211e28f2e7a188f8606bb8d963475d806bad06eff2cb5e34b493daf.mp3"
     },
     "image_by_hero": {

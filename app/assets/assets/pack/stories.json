     },
     "characters": [
      "hero"
     ],
     "outfit": "home",
     "location": "hallway_closed"
    },
    {
     "id": "s8",
     "order": 5,
     "text": {
      "ru": "Промываю рот водой из стакана."
     },
     "audio": {
      "ru": "story_media/226b80c249d49baeb27e7fa439387d7c39f2af96612a0de5d8098d9648c761a7.mp3"
     },

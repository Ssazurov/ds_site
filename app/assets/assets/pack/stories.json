   "category": "routine",
   "order": 99,
   "title": {
    "ru": "Я чищу зубы"
   },
   "tags": [],
   "level": 1,
   "steps": [
    {
     "id": "s3",
     "order": 1,
     "text": {
      "ru": "Я включаю свет и вхожу в ванную."
     },
     "audio": {
      "ru": "story_media/ead8162adfce07122c03f3c6fd9953299e6d18b6cb097e4be3fee2f5b1fd85c3.mp3"
     },
     "image_by_hero": {
      "girl": "story_media/6baa9259c408a935e582a91da1c11731a118bad5cdac7a2f274ccaee22bbef4e.webp"
     },
     "characters": [
      "hero"
     ],
     "outfit": "home",
     "location": "hallway"
    },
    {
     "id": "s5",
     "order": 2,
     "text": {
      "ru": "Беру щетку и зубную пасту."
     },
     "audio": {
      "ru": "story_media/dd033b028c2ae8f3c00981348bc8061978be13b600214c7dae2ea202d3d3370f.mp3"
     },
